# 默认文本文件统一使用 LF，避免 Windows/Linux 产生无意义差异
* text=auto eol=lf

# Windows 原生命令脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 常用源码与配置文件显式使用 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf

# 二进制文件禁止换行转换
*.jar binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
